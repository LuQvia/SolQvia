    "ja_carrier_no_click": "impressions >= 5 AND avg_position <= 10 AND prior gate",
    "en_carrier_no_click": "impressions >= 6 AND avg_position <= 10 AND prior_similarity <= 0.90 AND prior gate",
    "ja_noncarrier_no_click": "impressions >= 5 AND avg_position <= 10 AND prior gate",
    "en_noncarrier_no_click": "impressions >= 6 AND avg_position <= 12 AND prior gate",
    "final_post_cleanup_no_click_depth": "editorial chars >= 1800",
    "final_post_cleanup_carrier_similarity": "nearest-neighbor similarity <= 0.95"
  },
