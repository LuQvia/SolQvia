  "checked_at": "2026-09-22",
  "baseline_commit": "a50b66fc38d5394c743f82551245fc070170425e",
  "purpose": "Resolve the Phase166 blanket-unverified guard for the 22 Device Passport records added in Phase132-143 by mapping each exact record to current official satellite-provider device/purchase-source eligibility without family-name overreach.",
  "semantics": {
    "data_and_message": "Current official source confirms supported-app data plus messaging for the relevant purchase-source or exact-model scope.",
    "not_listed": "No match in the applicable current official supported-device list(s) at checked_at; this is not a permanent hardware-unsupported claim.",
    "explicitly_unsupported": "Current official source explicitly excludes this sales/program scope.",
    "future_listed": "Official service list contains the future device but it is not usable before release.",
    "future_announced": "Official product material indicates satellite support for a future device, but the current compatibility list does not yet make it usable.",
    "device_eligible_region_unavailable": "Device family meets platform hardware eligibility while Japan remains outside the platform service region.",
    "iot_listed_feature_level_unresolved": "Exact model is present on the official IOT list, but the current rendered feature-level table is ambiguous; keep runtime capability unknown."
  },
  "global_boundaries": [
    "Device family name match does not override purchase-source or exact-model restrictions.",
    "Carrier-purchased support does not prove SIM-free/open-market support.",
    "A future listed or announced device is not treated as currently usable.",
    "Not listed means not confirmed by the current official list, not permanent hardware impossibility.",
    "Google Pixel Satellite SOS device eligibility does not imply Japan availability.",
    "Apple-native satellite and carrier-provided satellite remain separate service paths.",
    "Rakuten AST SpaceMobile remains not launched at the checked date.",
    "No Phase167 record creates SolQvia real-device satellite evidence."
  ],
