  "rule_language": {
    "operators": [
      "eq",
      "neq",
      "in",
      "not_in",
      "known",
      "unknown",
      "truthy",
      "falsy"
    ],
    "condition_shape": {
      "observation": "canonical observation key",
      "op": "operator",
      "value": "optional scalar/array"
    },
    "rule_shape": {
      "id": "unique rule id",
      "goals": "applicable diagnosis goals",
      "all_of": "conditions that must all be true",
      "any_of": "optional conditions where at least one must be true",
      "exclude_if": "conditions that exclude the candidate",
      "candidate_failure_ids": "existing Phase156/157/158/160 failure IDs",
      "localized_when": "optional conditions sufficient to localize",
      "next_question_ids": "ordered question IDs if evidence is missing",
      "forbidden_inferences": "claims the engine must not make"
    }
  },
  "decision_policy": {
    "principles": [
      "Explicit failure outranks unknown.",
      "Unknown and not-tested states are evidence gaps, not failure evidence.",
      "The earliest unresolved dependency in the connectivity stack is preferred over later-layer speculation.",
      "When multiple candidates remain, choose the question that can eliminate the most candidates, then prefer lower-risk/lower-effort observations.",
      "A question already answered by a known observation is never asked again.",
      "No diagnosis may contradict a higher-confidence explicit observation.",
      "Runtime success at a later layer can rule out some earlier failures but does not reveal hidden internal implementation details.",
      "The engine returns candidate causes and next checks; it does not claim an unobserved root cause."
    ],
    "question_score": {
      "candidate_split_weight": 10,
      "dependency_order_weight": 4,
      "safety_weight": 3,
      "effort_penalty": 2,
      "already_answered_penalty": 1000
    }
  },
  "output_contract": {
    "required": [
      "diagnosis_status",
      "goal",
      "last_confirmed_layer",
      "first_explicit_failed_layer",
      "candidate_failure_ids",
      "next_question",
      "evidence_gaps",
      "forbidden_inferences"
    ]
  }
